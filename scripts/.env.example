# ClaudeDeck settings (user-editable).
#
# The installer seeds ~/.claude/sessions/.env from this file ONCE (it never
# overwrites an existing .env), so your edits survive updates. Edit .env, not
# this example. Changes apply the next time the weekly recap opens.

# === Weekly recap (Friday 17:00) : LLM synthesis ===========================
# Which LLM backend synthesizes the recap:
#   ollama  -> a native Ollama server (/api/generate)
#   openai  -> ANY OpenAI-compatible /v1/chat/completions endpoint
#              (OpenAI, OpenRouter, Groq, Together, Mistral, DeepSeek, LM Studio,
#               vLLM, llama.cpp server, or even Ollama's own /v1 endpoint)
LLM_PROVIDER=ollama

# --- Ollama provider (LLM_PROVIDER=ollama) ---------------------------------
# Base URL of the Ollama server and the model to use (must be pulled there).
# Defaults to a local Ollama install; point OLLAMA_URL at a remote host if yours
# runs elsewhere, and set OLLAMA_MODEL to any model you've pulled (`ollama list`).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# --- OpenAI-compatible provider (LLM_PROVIDER=openai) ----------------------
# Base URL WITHOUT the /v1 suffix (it is appended automatically), the model id,
# and an API key if the endpoint needs one (sent as "Authorization: Bearer ...").
# Examples:
#   LLM_URL=https://api.openai.com         LLM_MODEL=gpt-4o-mini
#   LLM_URL=https://openrouter.ai/api      LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#   LLM_URL=http://localhost:1234          LLM_MODEL=local-model   (LM Studio)
LLM_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Shared across providers ------------------------------------------------
# Master on/off: set to false to skip the LLM entirely and show the raw
# prompts/objectives. (Legacy name OLLAMA_ENABLED is still honoured.)
LLM_ENABLED=true

# Seconds to wait for a synthesis response before giving up (per project).
# (Legacy name OLLAMA_TIMEOUT is still honoured.)
LLM_TIMEOUT=60

# Include Claude's concluding takeaway for each turn (request -> outcome) in what
# is sent to the LLM. Set to false to send only your requests (smaller, faster).
RECAP_INCLUDE_OUTCOMES=true

# Max characters kept from each takeaway (it is truncated to this). Lower = leaner.
RECAP_OUTCOME_CHARS=250
